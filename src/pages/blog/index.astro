---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC'
});
---

<PageLayout title="Blog" active="Blog">
  <div class="blog-post-list-navigation">
    <a href="/blog/posts/">Blog post list →</a>
  </div>
  <div class="blog-list">
    {posts.map((post) => (
      <article class="post-preview">
        <a class="post-preview-link" href={`/blog/${post.id}/`}>
          <h2>{post.data.title}</h2>
          <p class="post-meta">{formatDate(post.data.date)}; {post.data.category}</p>
        </a>
        <p>{post.data.excerpt}</p>
      </article>
    ))}
  </div>
</PageLayout>
