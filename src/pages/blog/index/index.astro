---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const byYear = posts.reduce<Record<string, typeof posts>>((groups, post) => {
  const year = String(post.data.date.getUTCFullYear());
  (groups[year] ??= []).push(post);
  return groups;
}, {});
const groups = Object.entries(byYear).sort(([a], [b]) => Number(b) - Number(a));

const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
  month: 'short', day: 'numeric', timeZone: 'UTC'
});
---

<PageLayout title="Blog Index" active="Blog">
  <div class="blog-index">
    <nav class="blog-index-navigation" aria-label="Blog navigation">
      <a href="/blog/">← Back to blog</a>
    </nav>
    <h1>Index</h1>
    {groups.map(([year, yearPosts]) => (
      <section class="blog-index-year" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`}>{year}</h2>
        <ul class="blog-index-list">
          {yearPosts?.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              <span class="blog-index-date">{formatDate(post.data.date)}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</PageLayout>
